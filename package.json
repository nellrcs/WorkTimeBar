{
  "name": "worktimebar",
  "version": "1.0.0",
  "description": "Janela flutuante com barra de progresso e painel de controle para gerenciamento de tempo de atividades",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "build": "vite build",
    "dev": "vite",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "package-win": "electron-packager . --overwrite --asar=true --platform=win32 --arch=ia32 --icon=src/favicon.ico --prune=true --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"worktimebar\" --out=build"
  },
  "keywords": [
    "electron",
    "time-tracking",
    "progress-bar",
    "productivity",
    "overlay",
    "socket.io"
  ],
  "author": "warllencs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nellrcs/WorkTimeBar.git"
  },
  "homepage": "https://github.com/nellrcs/WorkTimeBar",
  "bugs": {
    "url": "https://github.com/nellrcs/WorkTimeBar/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@electron/packager": "^18.3.4",
    "@jest/globals": "^29.7.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "electron": "31.2.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.7.5",
    "update": "^0.7.4"
  }
}
